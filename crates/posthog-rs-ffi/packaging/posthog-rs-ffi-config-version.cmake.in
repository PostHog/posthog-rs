set(PACKAGE_VERSION "@VERSION@")

# Semantic versioning: before 1.0, a minor release can break the API.
if(PACKAGE_FIND_VERSION)
    string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _posthog_match "${PACKAGE_VERSION}")
    set(_posthog_major "${CMAKE_MATCH_1}")
    set(_posthog_minor "${CMAKE_MATCH_2}")
    if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    elseif(NOT PACKAGE_FIND_VERSION_MAJOR STREQUAL _posthog_major)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    elseif(_posthog_major STREQUAL "0" AND NOT PACKAGE_FIND_VERSION_MINOR STREQUAL _posthog_minor)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    else()
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
        if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
            set(PACKAGE_VERSION_EXACT TRUE)
        endif()
    endif()
    unset(_posthog_match)
    unset(_posthog_major)
    unset(_posthog_minor)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()

# Every archive is 64-bit.
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(PACKAGE_VERSION "${PACKAGE_VERSION} (64-bit)")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
